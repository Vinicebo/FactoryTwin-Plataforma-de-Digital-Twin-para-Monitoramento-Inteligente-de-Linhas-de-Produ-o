# Copie para `.env` antes de rodar o docker compose.
# Os valores abaixo são os defaults — bons para demonstração, não para produção.

# --- Banco de dados ---------------------------------------------------------
POSTGRES_USER=factorytwin
POSTGRES_PASSWORD=factorytwin
POSTGRES_DB=factorytwin
POSTGRES_PORT=5432

# --- Portas expostas --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Aplicação --------------------------------------------------------------
ENVIRONMENT=docker
DEBUG=false
# TROQUE em qualquer ambiente que não seja local: é a chave de assinatura do JWT.
SECRET_KEY=troque-esta-chave-em-producao-factorytwin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Administrador criado no primeiro boot ---------------------------------
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123

# --- Simulador --------------------------------------------------------------
SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=2.0
SIMULATOR_FAULT_PROBABILITY=0.004

# --- Machine Learning -------------------------------------------------------
ML_SCORING_ENABLED=true
ML_CONTAMINATION=0.03
