# Configuração do backend rodando fora do Docker.
# Copie para `backend/.env`. Sem este arquivo, os defaults de
# `app/core/config.py` já bastam para desenvolvimento (SQLite local).

# Deixe comentado para usar SQLite; descomente para apontar ao PostgreSQL.
# DATABASE_URL=postgresql+psycopg://factorytwin:factorytwin@localhost:5432/factorytwin

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=troque-esta-chave-em-producao-factorytwin

SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=2.0

ML_SCORING_ENABLED=true
